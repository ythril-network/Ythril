{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // See the note in tsconfig.base.json: a statement after a `return` cost a renamed space its usage history,
    // and by default tsc only greys it out in an editor. The client does not extend the base config, so the
    // flag has to be set in both places or half the codebase keeps the old behaviour.
    "allowUnreachableCode": false,
    // Unused locals and parameters are ERRORS. A binding nobody reads is either dead code or a value somebody
    // meant to use and did not, and until 5.3 there were 250 of them. An intentionally unused parameter is
    // spelled with a leading underscore.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleDetection": "force",
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"],
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "include": ["src/**/*.ts"]
}
