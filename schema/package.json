{
  "name": "@ythril-network/schema",
  "version": "6.5.0",
  "description": "The vocabulary of a Ythril space schema and the validator a Ythril server runs on it, for apps that write schemas.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ythril-network/Ythril.git",
    "directory": "schema"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./from-typescript": {
      "types": "./dist/from-typescript.d.ts",
      "import": "./dist/from-typescript.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node ../scripts/tsc.mjs -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@bufbuild/cel": "0.6.1",
    "@bufbuild/protobuf": "2.16.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "typescript": ">=5.4"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "typescript-6": "npm:typescript@^6"
  }
}
