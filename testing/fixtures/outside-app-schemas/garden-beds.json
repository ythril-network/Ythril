    "chrono": {
      "reminder": {
        "description": "A reminder a gardener set: water the seedlings, check the frost cover. Nothing happens on its own when it passes.",
        "whenDuePasses": "nothing",
        "propertySchemas": {
          "key": {
            "description": "The planner's key of this record, a UUID the planner minted; the same in every space the record is copied to. The planner's references hold it.",
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "required": true
          },
          "action": {
            "description": "What the reminder is for.",
            "type": "string",
            "enum": [
              "set",
              "snooze",
              "cancel"
            ],
            "required": true
          },
          "repeatDays": {
            "description": "Repeat every so many days; absent, once.",
            "type": "number",
            "minimum": 1,
            "maximum": 365
          },
          "bedRef": {
            "description": "The key of the bed this record belongs to.",
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "rules": {
          "repeats": {
            "rule": "self.properties.action == 'cancel' || has(self.properties.bedRef)",
            "message": "A reminder that is set or snoozed names its bed"
          }
        }
      }
    }
  }
}
